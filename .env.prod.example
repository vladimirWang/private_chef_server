# 复制为 private_chef_server/.env.prod 后填写。
# deploy/docker-compose.yml 里数据库服务名为 postgres，容器内端口 5432。
# DATABASE_URL 须写完整连接串（与 POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB 一致）。

DATABASE_URL=postgresql://postgres:请修改为强密码@postgres:5432/your_db?schema=public
DATABASE_PASSWORD=请修改为强密码
DATABASE_NAME=your_db
DATABASE_USER=postgres

JWT_SECRET=请修改为随机串
